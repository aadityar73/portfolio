---
import { experience } from "../data/site";
import Logo from "./Logo.astro";
import Section from "./Section.astro";
---

<Section id="work" index="02" label="Experience">
  <ol class="-mt-8">
    {
      experience.map((job) => (
        <li class="grid grid-cols-[auto_1fr] gap-x-5 border-b border-line py-8 last:border-b-0 last:pb-0 sm:gap-x-7">
          <Logo name={job.company} src={job.logo} />
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-xl font-medium md:text-2xl">
                {job.role}{" "}
                <span class="font-display text-[1.15em] font-normal text-muted italic">at</span>{" "}
                {job.url ? (
                  <a href={job.url} target="_blank" rel="noopener" class="link-draw">
                    {job.company}
                  </a>
                ) : (
                  job.company
                )}
              </h3>
              <p class="font-mono text-xs text-muted">
                {job.start} – {job.end}
              </p>
            </div>

            <ul class="mt-5 max-w-[62ch] space-y-2.5 text-muted">
              {job.points.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-[0.6em] size-1.5 shrink-0 bg-accent-text" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>

            {job.tech.length > 0 && <p class="mt-5 font-mono text-xs text-muted">{job.tech.join("  /  ")}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</Section>
