---
import { site } from "../data/site";
import { splitMarkers } from "../scripts/markers";
import Section from "./Section.astro";
---

<Section id="about" index="01" label="About">
  <div class="flex flex-col-reverse gap-10 md:flex-row md:items-start md:justify-between">
    <div class="max-w-[60ch] space-y-6 text-xl leading-relaxed md:text-2xl md:leading-relaxed">
      {
        site.about.map((paragraph) => (
          <p>
            {splitMarkers(paragraph).map((part) =>
              part.marked ? <span class="marker">{part.text}</span> : part.text,
            )}
          </p>
        ))
      }
    </div>

    {
      site.photo && (
        <img
          src={site.photo}
          alt={`Photo of ${site.firstName} ${site.lastName}`}
          width="600"
          height="600"
          loading="lazy"
          class="aspect-square w-40 shrink-0 rounded-md object-cover ring-1 ring-line grayscale transition duration-700 hover:grayscale-0 md:w-56"
        />
      )
    }
  </div>
</Section>
