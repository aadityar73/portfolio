---
import { site } from "../data/site";
import { splitMarkers } from "../scripts/markers";

const intro = splitMarkers(site.intro);
---

<section class="mx-auto flex min-h-[100svh] max-w-[1400px] flex-col justify-end px-5 pt-28 pb-10 md:px-10 md:pb-14">
  <p class="fade-late mb-6 font-mono text-xs tracking-wide text-muted uppercase md:mb-8">
    {site.role}
  </p>

  <h1 class="font-display text-[clamp(4.5rem,19vw,17rem)] leading-[0.82] tracking-[-0.02em]">
    <span class="-mb-[0.16em] block overflow-hidden pb-[0.22em]"><span class="rise">{site.firstName}</span></span>
    <span class="-mb-[0.14em] block overflow-hidden pb-[0.22em] md:pl-[16vw]">
      <span class="rise italic" style="animation-delay: 110ms">{site.lastName}</span><span
        class="rise text-accent-text"
        style="animation-delay: 220ms">.</span
      >
    </span>
  </h1>

  <div class="fade-late mt-10 grid grid-cols-1 gap-10 border-t border-line pt-6 md:mt-14 md:grid-cols-12">
    <p class="max-w-[34ch] text-xl leading-snug text-balance md:col-span-7 md:text-[1.7rem]">
      {intro.map((part) => (part.marked ? <span class="marker">{part.text}</span> : part.text))}
    </p>

    <div class="md:col-span-4 md:col-start-9">
      <p class="mb-3 font-mono text-xs tracking-wide text-muted uppercase">Currently</p>
      <ul class="space-y-1.5 text-base">
        {
          site.currently.map((line) => (
            <li class="flex gap-3">
              <span class="mt-[0.6em] size-1.5 shrink-0 bg-accent-text" aria-hidden="true" />
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
