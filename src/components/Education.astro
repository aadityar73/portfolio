---
import { education } from "../data/site";
import Logo from "./Logo.astro";
import Section from "./Section.astro";
---

<Section id="education" index="04" label="Education">
  <ol class="-mt-8">
    {
      education.map((item) => (
        <li class="grid grid-cols-[auto_1fr] gap-x-5 border-b border-line py-8 last:border-b-0 last:pb-0 sm:gap-x-7">
          <Logo name={item.school} src={item.logo} />
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <div>
              <h3 class="text-xl font-medium md:text-2xl">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener" class="link-draw">
                    {item.school}
                  </a>
                ) : (
                  item.school
                )}
              </h3>
              <p class="mt-1 text-muted">
                {item.degree}
                {item.note && <span> · {item.note}</span>}
              </p>
            </div>
            <p class="font-mono text-xs text-muted">
              {item.start} – {item.end}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
