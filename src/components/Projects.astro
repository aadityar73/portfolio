---
import { projects } from "../data/site";
import Section from "./Section.astro";

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<Section id="projects" index="03" label="Selected projects">
  <ul data-projects class="-mt-6">
    {
      projects.map((project, i) => (
        <li data-project={i} class="group border-b border-line py-7 last:border-b-0 last:pb-0 md:py-9">
          <div class="grid grid-cols-[2.25rem_1fr] gap-x-3 md:grid-cols-[3rem_1fr] md:gap-x-6">
            <span class="pt-[0.9em] font-mono text-xs text-muted md:pt-[1.4em]">{pad(i)}</span>

            <div>
              <h3 class="font-display text-[2.6rem] leading-[1] transition-transform duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:translate-x-2 md:text-6xl">
                {project.title}{" "}
                <span
                  class="inline-block -translate-x-2 text-accent-text opacity-0 transition duration-500 group-hover:translate-x-0 group-hover:opacity-100"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </h3>
              <p class="mt-3 max-w-[56ch] text-muted">{project.description}</p>

              {project.image && (
                <img
                  src={project.image}
                  alt={`Screenshot of ${project.title}`}
                  loading="lazy"
                  class="mt-5 aspect-[16/10] w-full rounded-md object-cover ring-1 ring-line md:hidden"
                />
              )}

              <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs">
                <span class="text-muted">{project.tech.join("  /  ")}</span>
                {project.links.map((link) => (
                  <span>
                    <a href={link.href} target="_blank" rel="noopener" class="link-draw text-accent-text">
                      {`${link.label} ↗`}
                    </a>
                    {link.note && <span class="text-muted">{` (${link.note})`}</span>}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <!-- Floating preview that follows the cursor on desktop. -->
  <div
    data-preview
    class="pointer-events-none fixed top-0 left-0 z-40 hidden aspect-[16/10] w-[22rem] overflow-hidden rounded-md opacity-0 shadow-2xl ring-1 ring-line transition-opacity duration-300"
    aria-hidden="true"
  >
    {
      projects.map((project, i) =>
        project.image ? (
          <img data-preview-item={i} src={project.image} alt="" class="hidden size-full object-cover" />
        ) : (
          <div data-preview-item={i} class="hidden size-full flex-col justify-between bg-accent p-5 text-on-accent">
            <span class="font-mono text-xs">{pad(i)}</span>
            <span class="font-display text-4xl leading-none italic">{project.title}</span>
          </div>
        ),
      )
    }
  </div>
</Section>

<script>
  const list = document.querySelector<HTMLElement>("[data-projects]");
  const preview = document.querySelector<HTMLElement>("[data-preview]");
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (list && preview && canHover) {
    preview.classList.remove("hidden");
    const items = preview.querySelectorAll<HTMLElement>("[data-preview-item]");
    let target = { x: 0, y: 0 };
    let current = { x: 0, y: 0 };
    let frame = 0;

    const render = () => {
      const ease = reduceMotion ? 1 : 0.16;
      current.x += (target.x - current.x) * ease;
      current.y += (target.y - current.y) * ease;
      const width = preview.offsetWidth;
      const left = current.x + 24 + width > innerWidth - 16 ? current.x - 24 - width : current.x + 24;
      preview.style.transform = `translate3d(${left}px, ${current.y - preview.offsetHeight / 2}px, 0)`;
      frame = Math.abs(target.x - current.x) + Math.abs(target.y - current.y) > 0.5 ? requestAnimationFrame(render) : 0;
    };

    list.addEventListener("pointermove", (event) => {
      target = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(render);
    });

    for (const row of list.querySelectorAll<HTMLElement>("[data-project]")) {
      row.addEventListener("pointerenter", (event) => {
        for (const item of items) {
          const show = item.dataset.previewItem === row.dataset.project;
          item.classList.toggle("hidden", !show);
          item.classList.toggle("flex", show && item.tagName === "DIV");
        }
        if (preview.style.opacity !== "1") {
          target = { x: event.clientX, y: event.clientY };
          current = { ...target };
          render();
        }
        preview.style.opacity = "1";
      });
    }

    list.addEventListener("pointerleave", () => (preview.style.opacity = "0"));
  }
</script>
